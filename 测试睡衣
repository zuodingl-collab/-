        <div class="card-title">⬇️ 导出图片</div>
        <button class="btn-primary" id="downloadBtn" disabled>
          💾 &nbsp;下载带水印图片
        </button>
        <div style="height:10px;"></div>
        <button class="btn-secondary" id="resetBtn">
          🔄 &nbsp;重新上传
        </button>
      </div>

      <!-- Tips -->
      <div class="card" style="background:rgba(201,169,154,0.12);">
        <div class="card-title">💡 使用贴士</div>
        <ul style="list-style:none;display:flex;flex-direction:column;gap:8px;">
          <li style="font-size:12.5px;color:var(--text-secondary);display:flex;gap:8px;align-items:flex-start;">
            <span>🌸</span><span>水印以 -30° 倾斜全屏铺满，有效防止局部裁剪去除水印</span>
          </li>
          <li style="font-size:12.5px;color:var(--text-secondary);display:flex;gap:8px;align-items:flex-start;">
            <span>🔒</span><span>所有处理均在您的浏览器本地完成，图片不会离开您的设备</span>
          </li>
          <li style="font-size:12.5px;color:var(--text-secondary);display:flex;gap:8px;align-items:flex-start;">
            <span>🎨</span><span>建议透明度 25-45%，既清晰可见又不遮挡原文内容</span>
          </li>
          <li style="font-size:12.5px;color:var(--text-secondary);display:flex;gap:8px;align-items:flex-start;">
            <span>💾</span><span>导出为原始尺寸高清 PNG，保留完整图片质量</span>
          </li>
        </ul>
      </div>
    </div>
  </main>

  <!-- Footer -->
  <footer>
    <span>🌸 女书水印工具 · 为清醒的女性而建 · 纯本地处理 无服务器 永远安全</span>
  </footer>

  <!-- Toast -->
  <div class="toast" id="toast"></div>

  <script>
    // ─── State ───────────────────────────────────────────────────────────
    let originalImage = null;
    let renderTimer = null;

    // ─── DOM References ───────────────────────────────────────────────────
    const uploadZone      = document.getElementById('uploadZone');
    const fileInput       = document.getElementById('fileInput');
    const previewCanvas   = document.getElementById('previewCanvas');
    const previewWrapper  = document.getElementById('previewWrapper');
    const previewPlaceholder = document.getElementById('previewPlaceholder');
    const imageInfoBar    = document.getElementById('imageInfoBar');
    const imageInfoName   = document.getElementById('imageInfoName');
    const imageInfoSize   = document.getElementById('imageInfoSize');
    const downloadBtn     = document.getElementById('downloadBtn');
    const resetBtn        = document.getElementById('resetBtn');
    const wmText          = document.getElementById('wmText');
    const wmFontSize      = document.getElementById('wmFontSize');
    const wmColor         = document.getElementById('wmColor');
    const wmOpacity       = document.getElementById('wmOpacity');
    const wmSpacing       = document.getElementById('wmSpacing');
    const fontSizeVal     = document.getElementById('fontSizeVal');
    const opacityVal      = document.getElementById('opacityVal');
    const spacingVal      = document.getElementById('spacingVal');
    const colorSwatch     = document.getElementById('colorSwatch');
    const colorPresets    = document.getElementById('colorPresets');
    const toast           = document.getElementById('toast');

    // ─── Upload Zone Events ───────────────────────────────────────────────
    uploadZone.addEventListener('click', () => fileInput.click());

    uploadZone.addEventListener('dragover', (e) => {
      e.preventDefault();
      uploadZone.classList.add('dragover');
    });

    uploadZone.addEventListener('dragleave', () => {
      uploadZone.classList.remove('dragover');
    });

    uploadZone.addEventListener('drop', (e) => {
      e.preventDefault();
      uploadZone.classList.remove('dragover');
      const files = e.dataTransfer.files;
      if (files && files[0]) loadImageFile(files[0]);
    });

    fileInput.addEventListener('change', () => {
      if (fileInput.files[0]) loadImageFile(fileInput.files[0]);
    });

    // ─── Load Image ───────────────────────────────────────────────────────
    function loadImageFile(file) {
      if (!file.type.startsWith('image/')) {
        showToast('⚠️ 请上传图片文件');
        return;
      }

      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          originalImage = img;
          previewPlaceholder.style.display = 'none';
          previewCanvas.style.display = 'block';
          downloadBtn.disabled = false;

          // Info bar
          imageInfoBar.classList.add('visible');
          imageInfoName.textContent = file.name.length > 22 ? file.name.substring(0, 20) + '…' : file.name;
          imageInfoSize.textContent = formatBytes(file.size);

          scheduleRender();
          showToast('🌸 图片加载成功！');
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function formatBytes(bytes) {
      if (bytes < 1024) return bytes + ' B';
      if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
      return (bytes / 1024 / 1024).toFixed(2) + ' MB';
    }

    // ─── Watermark Render ─────────────────────────────────────────────────
    function scheduleRender() {
      clearTimeout(renderTimer);
      renderTimer = setTimeout(renderWatermark, 60);
    }

    function renderWatermark(targetCanvas) {
      if (!originalImage) return;

      const canvas = targetCanvas || previewCanvas;
      const ctx = canvas.getContext('2d');

      // Set canvas size to original image size
      canvas.width  = originalImage.naturalWidth;
      canvas.height = originalImage.naturalHeight;

      // Draw original image
      ctx.drawImage(originalImage, 0, 0);

      // ── Watermark Parameters ──
      const text    = wmText.value.trim() || '仅供女子清醒读书会打卡使用，他用无效';
      const size    = parseInt(wmFontSize.value);
      const opacity = parseInt(wmOpacity.value) / 100;
      const spacing = parseInt(wmSpacing.value) / 10; // 1.0 – 3.0
      const color   = wmColor.value;
      const angle   = -30 * (Math.PI / 180);

      // ── Build font ──
      ctx.save();
      ctx.font = `${size}px "Noto Serif SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif`;
      ctx.textBaseline  = 'middle';
      ctx.textAlign     = 'left';

      // Measure single text width
      const metrics   = ctx.measureText(text);
      const textW     = metrics.width;
      const textH     = size;

      // ── Tiling with full-canvas coverage ──
      // Step sizes in the rotated space to ensure full coverage
      const stepX = (textW + size * 3) * spacing;
      const stepY = (textH + size * 2) * spacing;

      // Determine how far we need to tile (cover diagonal of canvas)
      const diagonal = Math.sqrt(canvas.width ** 2 + canvas.height ** 2);
      const countX   = Math.ceil(diagonal / stepX) + 2;
      const countY   = Math.ceil(diagonal / stepY) + 2;

      // Parse hex color -> rgba
      const [r, g, b] = hexToRgb(color);

      ctx.globalAlpha = opacity;
      ctx.fillStyle   = `rgb(${r},${g},${b})`;

      // Center-based tiling: start from canvas center, tile in all directions
      const cx = canvas.width / 2;
      const cy = canvas.height / 2;

      ctx.translate(cx, cy);
      ctx.rotate(angle);

      for (let xi = -countX; xi <= countX; xi++) {
        for (let yi = -countY; yi <= countY; yi++) {
          const tx = xi * stepX;
          const ty = yi * stepY;

          // Alternate rows for denser, non-linear-aligned look
          const offsetX = (yi % 2 !== 0) ? stepX / 2 : 0;

          ctx.fillText(text, tx + offsetX - textW / 2, ty);
        }
      }

      ctx.restore();
    }

    function hexToRgb(hex) {
      const result = /^#?([a-f\d]{2})([a-f\d]{2})([a-f\d]{2})$/i.exec(hex);
      return result
        ? [parseInt(result[1], 16), parseInt(result[2], 16), parseInt(result[3], 16)]
        : [176, 139, 139];
    }

    // ─── Control Events ───────────────────────────────────────────────────
    wmText.addEventListener('input', scheduleRender);

    wmFontSize.addEventListener('input', () => {
      fontSizeVal.textContent = wmFontSize.value;
      scheduleRender();
    });

    wmOpacity.addEventListener('input', () => {
      opacityVal.textContent = wmOpacity.value;
      scheduleRender();
    });

    wmSpacing.addEventListener('input', () => {
      spacingVal.textContent = (parseInt(wmSpacing.value) / 10).toFixed(1);
      scheduleRender();
    });

    wmColor.addEventListener('input', () => {
      colorSwatch.style.background = wmColor.value;
      clearActivePresets();
      scheduleRender();
    });

    // Color presets
    colorPresets.querySelectorAll('.preset-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const color = btn.dataset.color;
        wmColor.value   = color;
        colorSwatch.style.background = color;
        clearActivePresets();
        btn.classList.add('active');
        scheduleRender();
      });
    });

    function clearActivePresets() {
      colorPresets.querySelectorAll('.preset-btn').forEach(b => b.classList.remove('active'));
    }

    // ─── Download ─────────────────────────────────────────────────────────
    downloadBtn.addEventListener('click', () => {
      if (!originalImage) return;

      // Show loading state
      const originalText = downloadBtn.innerHTML;
      downloadBtn.disabled = true;
      downloadBtn.innerHTML = '<span class="spinner"></span>生成中…';

      // Use a fresh high-res canvas
      const exportCanvas = document.createElement('canvas');
      renderWatermark(exportCanvas);

      // Small delay to allow spinner to show
      setTimeout(() => {
        const link      = document.createElement('a');
        const timestamp = new Date().toISOString().slice(0, 19).replace(/[:\-T]/g, '').replace(/^(\d{8})(\d{6})$/, '$1_$2');
        link.download   = `watermarked_${timestamp}.png`;
        link.href       = exportCanvas.toDataURL('image/png', 1.0);
        link.click();

        downloadBtn.disabled  = false;
        downloadBtn.innerHTML = originalText;
        showToast('✅ 图片已保存到本地！');
      }, 120);
    });

    // ─── Reset ────────────────────────────────────────────────────────────
    resetBtn.addEventListener('click', () => {
      originalImage = null;
      fileInput.value = '';
      previewCanvas.style.display  = 'none';
      previewPlaceholder.style.display = '';
      imageInfoBar.classList.remove('visible');
      downloadBtn.disabled = true;

      const ctx = previewCanvas.getContext('2d');
      ctx.clearRect(0, 0, previewCanvas.width, previewCanvas.height);

      showToast('🔄 已清空，请重新上传图片');
    });

    // ─── Toast ────────────────────────────────────────────────────────────
    let toastTimer;
    function showToast(msg) {
      toast.textContent = msg;
      toast.classList.add('show');
      clearTimeout(toastTimer);
      toastTimer = setTimeout(() => toast.classList.remove('show'), 2600);
    }

    // ─── Init slider display values ───────────────────────────────────────
    fontSizeVal.textContent = wmFontSize.value;
    opacityVal.textContent  = wmOpacity.value;
    spacingVal.textContent  = (parseInt(wmSpacing.value) / 10).toFixed(1);
    colorSwatch.style.background = wmColor.value;
  </script>
</body>
</html>
