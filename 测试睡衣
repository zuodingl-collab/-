  <style>
    :root {
      --cream: #faf6f1;
      --parchment: #f3ede4;
      --blush: #e8d5cc;
      --dusty-rose: #c9a99a;
      --mauve: #b08b8b;
      --warm-brown: #7a5c5c;
      --deep-plum: #4a3040;
      --sage: #9caa8e;
      --sage-light: #c8d5be;
      --mist: #d6dde8;
      --lavender: #c4bdd6;
      --gold: #c9a86c;
      --gold-light: #e8d4a8;
      --shadow: rgba(74, 48, 64, 0.12);
      --shadow-hover: rgba(74, 48, 64, 0.22);
      --text-primary: #3d2b2b;
      --text-secondary: #7a5c5c;
      --text-muted: #a08080;
      --radius-sm: 8px;
      --radius-md: 16px;
      --radius-lg: 24px;
      --radius-xl: 32px;
      --transition: 0.35s cubic-bezier(0.4, 0, 0.2, 1);
    }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: 'Noto Sans SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
      background: var(--cream);
      color: var(--text-primary);
      min-height: 100vh;
      overflow-x: hidden;
    }

    /* ── Background Decoration ── */
    body::before {
      content: '';
      position: fixed;
      inset: 0;
      background:
        radial-gradient(ellipse 60% 40% at 10% 15%, rgba(201,169,154,0.18) 0%, transparent 60%),
        radial-gradient(ellipse 50% 60% at 90% 80%, rgba(196,189,214,0.18) 0%, transparent 60%),
        radial-gradient(ellipse 40% 30% at 50% 50%, rgba(156,170,142,0.08) 0%, transparent 70%);
      pointer-events: none;
      z-index: 0;
    }

    /* ── Privacy Banner ── */
    .privacy-banner {
      position: relative;
      z-index: 10;
      background: linear-gradient(135deg, var(--sage) 0%, var(--sage-light) 100%);
      color: #fff;
      text-align: center;
      padding: 10px 20px;
      font-size: 13px;
      font-weight: 500;
      letter-spacing: 0.5px;
      text-shadow: 0 1px 2px rgba(0,0,0,0.15);
    }

    .privacy-banner span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* ── Header ── */
    header {
      position: relative;
      z-index: 5;
      padding: 48px 24px 32px;
      text-align: center;
    }

    .header-ornament {
      font-size: 28px;
      margin-bottom: 12px;
      display: block;
      animation: float 4s ease-in-out infinite;
    }

    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-6px); }
    }

    h1 {
      font-family: 'Noto Serif SC', serif;
      font-size: clamp(26px, 5vw, 38px);
      font-weight: 600;
      color: var(--deep-plum);
      letter-spacing: 3px;
      line-height: 1.3;
    }

    h1 em {
      font-style: normal;
      color: var(--mauve);
    }

    .header-sub {
      margin-top: 10px;
      font-size: 13px;
      color: var(--text-muted);
      letter-spacing: 1.5px;
      font-weight: 300;
    }

    .header-divider {
      width: 80px;
      height: 1.5px;
      background: linear-gradient(90deg, transparent, var(--dusty-rose), transparent);
      margin: 20px auto 0;
    }

    /* ── Main Layout ── */
    main {
      position: relative;
      z-index: 5;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 24px 80px;
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 28px;
      align-items: start;
    }

    @media (max-width: 860px) {
      main {
        grid-template-columns: 1fr;
      }
    }

    /* ── Card ── */
    .card {
      background: rgba(255,255,255,0.72);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255,255,255,0.85);
      border-radius: var(--radius-lg);
      padding: 28px;
      box-shadow: 0 4px 24px var(--shadow), 0 1px 3px rgba(255,255,255,0.8) inset;
      transition: box-shadow var(--transition);
    }

    .card:hover {
      box-shadow: 0 8px 40px var(--shadow-hover), 0 1px 3px rgba(255,255,255,0.8) inset;
    }

    .card-title {
      font-family: 'Noto Serif SC', serif;
      font-size: 15px;
      font-weight: 500;
      color: var(--warm-brown);
      letter-spacing: 2px;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .card-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: linear-gradient(90deg, var(--blush), transparent);
    }

    /* ── Upload Zone ── */
    .upload-zone {
      border: 2px dashed var(--blush);
      border-radius: var(--radius-md);
      padding: 40px 20px;
      text-align: center;
      cursor: pointer;
      transition: all var(--transition);
      background: rgba(250,246,241,0.6);
      position: relative;
      overflow: hidden;
    }

    .upload-zone::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(201,169,154,0.08), rgba(196,189,214,0.08));
      opacity: 0;
      transition: opacity var(--transition);
    }

    .upload-zone:hover,
    .upload-zone.dragover {
      border-color: var(--dusty-rose);
      background: rgba(232,213,204,0.2);
      transform: translateY(-2px);
    }

    .upload-zone:hover::before,
    .upload-zone.dragover::before {
      opacity: 1;
    }

    .upload-icon {
      font-size: 48px;
      margin-bottom: 14px;
      display: block;
      transition: transform var(--transition);
    }

    .upload-zone:hover .upload-icon {
      transform: scale(1.1);
    }

    .upload-text {
      font-size: 15px;
      color: var(--text-secondary);
      letter-spacing: 0.5px;
    }

    .upload-hint {
      margin-top: 6px;
      font-size: 12px;
      color: var(--text-muted);
    }

    #fileInput {
      display: none;
    }

    /* ── Preview ── */
    .preview-wrapper {
      position: relative;
      border-radius: var(--radius-md);
      overflow: hidden;
      background: var(--parchment);
      min-height: 200px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #previewCanvas {
      display: block;
      width: 100%;
      height: auto;
      border-radius: var(--radius-md);
      transition: opacity 0.4s ease;
    }

    .preview-placeholder {
      padding: 40px;
      text-align: center;
      color: var(--text-muted);
      font-size: 13px;
    }

    .preview-placeholder .ph-icon {
      font-size: 40px;
      display: block;
      margin-bottom: 10px;
      opacity: 0.5;
    }

    /* ── Controls ── */
    .controls-col {
      display: flex;
      flex-direction: column;
      gap: 20px;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    label {
      font-size: 13px;
      color: var(--text-secondary);
      letter-spacing: 0.8px;
      font-weight: 500;
    }

    textarea, input[type="text"] {
      width: 100%;
      padding: 12px 16px;
      border: 1.5px solid var(--blush);
      border-radius: var(--radius-sm);
      background: rgba(255,255,255,0.7);
      color: var(--text-primary);
      font-family: inherit;
      font-size: 14px;
      transition: all var(--transition);
      resize: vertical;
      outline: none;
    }

    textarea:focus, input[type="text"]:focus {
      border-color: var(--dusty-rose);
      background: rgba(255,255,255,0.95);
      box-shadow: 0 0 0 3px rgba(201,169,154,0.18);
    }

    textarea {
      min-height: 80px;
      line-height: 1.6;
    }

    /* ── Slider Row ── */
    .slider-row {
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .slider-value {
      min-width: 36px;
      text-align: right;
      font-size: 13px;
      color: var(--mauve);
      font-weight: 500;
    }

    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      flex: 1;
      height: 4px;
      border-radius: 4px;
      background: var(--blush);
      outline: none;
      cursor: pointer;
    }

    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--dusty-rose);
      cursor: pointer;
      box-shadow: 0 2px 8px rgba(176,139,139,0.4);
      transition: all var(--transition);
    }

    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.2);
      background: var(--mauve);
    }

    input[type="range"]::-moz-range-thumb {
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: var(--dusty-rose);
      cursor: pointer;
      border: none;
      box-shadow: 0 2px 8px rgba(176,139,139,0.4);
    }

    /* ── Color Row ── */
    .color-row {
      display: flex;
      align-items: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .color-picker-wrapper {
      position: relative;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      overflow: hidden;
      border: 3px solid var(--blush);
      cursor: pointer;
      box-shadow: 0 2px 8px var(--shadow);
      transition: all var(--transition);
      flex-shrink: 0;
    }

    .color-picker-wrapper:hover {
      transform: scale(1.1);
      border-color: var(--dusty-rose);
    }

    input[type="color"] {
      position: absolute;
      inset: -8px;
      width: calc(100% + 16px);
      height: calc(100% + 16px);
      border: none;
      padding: 0;
      cursor: pointer;
      opacity: 0.01;
    }

    .color-swatch {
      position: absolute;
      inset: 0;
      border-radius: 50%;
      pointer-events: none;
    }

    .color-presets {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .preset-btn {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      border: 2px solid transparent;
      cursor: pointer;
      transition: all var(--transition);
      padding: 0;
      position: relative;
    }

    .preset-btn:hover,
    .preset-btn.active {
      transform: scale(1.25);
      border-color: var(--warm-brown);
      box-shadow: 0 2px 8px var(--shadow);
    }

    /* ── Buttons ── */
    .btn-primary {
      width: 100%;
      padding: 14px 24px;
      border: none;
      border-radius: var(--radius-xl);
      background: linear-gradient(135deg, var(--dusty-rose) 0%, var(--mauve) 100%);
      color: #fff;
      font-family: 'Noto Serif SC', serif;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 2px;
      cursor: pointer;
      transition: all var(--transition);
      box-shadow: 0 4px 20px rgba(176,139,139,0.35);
      position: relative;
      overflow: hidden;
    }

    .btn-primary::before {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(135deg, rgba(255,255,255,0.15) 0%, transparent 50%);
      opacity: 0;
      transition: opacity var(--transition);
    }

    .btn-primary:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 30px rgba(176,139,139,0.45);
    }

    .btn-primary:hover::before {
      opacity: 1;
    }

    .btn-primary:active {
      transform: translateY(0);
    }

    .btn-primary:disabled {
      opacity: 0.5;
      cursor: not-allowed;
      transform: none;
    }

    .btn-secondary {
      width: 100%;
      padding: 12px 24px;
      border: 1.5px solid var(--blush);
      border-radius: var(--radius-xl);
      background: rgba(255,255,255,0.7);
      color: var(--text-secondary);
      font-family: inherit;
      font-size: 14px;
      font-weight: 500;
      letter-spacing: 1px;
      cursor: pointer;
      transition: all var(--transition);
    }

    .btn-secondary:hover {
      border-color: var(--dusty-rose);
      color: var(--warm-brown);
      background: rgba(232,213,204,0.25);
      transform: translateY(-1px);
    }

    /* ── Toast ── */
    .toast {
      position: fixed;
      bottom: 30px;
      left: 50%;
      transform: translateX(-50%) translateY(20px);
      background: var(--deep-plum);
      color: rgba(255,255,255,0.95);
      padding: 12px 28px;
      border-radius: var(--radius-xl);
      font-size: 14px;
      letter-spacing: 0.5px;
      opacity: 0;
      pointer-events: none;
      transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
      z-index: 9999;
      box-shadow: 0 8px 30px rgba(74,48,64,0.3);
    }

    .toast.show {
      opacity: 1;
      transform: translateX(-50%) translateY(0);
    }

    /* ── Info Tags ── */
    .info-tags {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      margin-bottom: 6px;
    }

    .tag {
      padding: 4px 10px;
      border-radius: 20px;
      font-size: 11px;
      letter-spacing: 0.5px;
      font-weight: 500;
    }

    .tag-rose { background: rgba(201,169,154,0.2); color: var(--warm-brown); }
    .tag-sage { background: rgba(156,170,142,0.2); color: #5c7050; }
    .tag-lavender { background: rgba(196,189,214,0.2); color: #6b5e80; }

    /* ── Divider ── */
    .section-divider {
      height: 1px;
      background: linear-gradient(90deg, transparent, var(--blush), transparent);
      margin: 4px 0;
    }

    /* ── Footer ── */
    footer {
      position: relative;
      z-index: 5;
      text-align: center;
      padding: 20px 24px 40px;
      font-size: 12px;
      color: var(--text-muted);
      letter-spacing: 1px;
    }

    footer span {
      display: inline-flex;
      align-items: center;
      gap: 6px;
    }

    /* ── Petal Decorations ── */
    .petal {
      position: fixed;
      pointer-events: none;
      z-index: 1;
      opacity: 0.12;
      font-size: 24px;
      animation: petaldrift 20s ease-in-out infinite;
    }

    .petal:nth-child(1) { top: 8%; left: 3%; animation-delay: 0s; }
    .petal:nth-child(2) { top: 20%; right: 5%; animation-delay: -5s; animation-duration: 25s; }
    .petal:nth-child(3) { top: 65%; left: 2%; animation-delay: -10s; animation-duration: 18s; }
    .petal:nth-child(4) { bottom: 15%; right: 3%; animation-delay: -15s; animation-duration: 22s; }
    .petal:nth-child(5) { top: 45%; right: 6%; animation-delay: -8s; animation-duration: 28s; font-size: 18px; }

    @keyframes petaldrift {
      0%, 100% { transform: translateY(0) rotate(0deg); }
      33% { transform: translateY(-20px) rotate(10deg); }
      66% { transform: translateY(10px) rotate(-8deg); }
    }

    /* ── Loading Spinner ── */
    .spinner {
      display: inline-block;
      width: 16px;
      height: 16px;
      border: 2px solid rgba(255,255,255,0.4);
      border-top-color: #fff;
      border-radius: 50%;
      animation: spin 0.7s linear infinite;
      vertical-align: middle;
      margin-right: 8px;
    }

    @keyframes spin {
      to { transform: rotate(360deg); }
    }

    /* ── Image Info Bar ── */
    .image-info-bar {
      display: none;
      align-items: center;
      justify-content: space-between;
      padding: 8px 14px;
      background: rgba(201,169,154,0.15);
      border-radius: var(--radius-sm);
      margin-top: 10px;
      font-size: 12px;
      color: var(--text-muted);
    }

    .image-info-bar.visible {
      display: flex;
    }

    /* ── Scrollbar ── */
    ::-webkit-scrollbar { width: 6px; }
    ::-webkit-scrollbar-track { background: var(--cream); }
    ::-webkit-scrollbar-thumb { background: var(--blush); border-radius: 3px; }
    ::-webkit-scrollbar-thumb:hover { background: var(--dusty-rose); }
  </style>
</head>
